# Kopie als .env.local (lokal) bzw. als Environment Variables in Vercel hinterlegen.
# Niemals echte Schlüssel ins Repository committen.

# Öffentliche Adresse der App, z. B. https://arbitrage-radar.de
APP_URL=http://localhost:3000

# Postgres (z. B. Neon, Region Frankfurt). Ohne Wert nutzt die Entwicklung eine eingebettete Datenbank.
DATABASE_URL=

# Zufällige Geheimnisse, je mindestens 32 Zeichen: `openssl rand -base64 48`
AUTH_SECRET=
# Schlüssel für die Verschlüsselung der Marktplatz-Tokens: `openssl rand -base64 32`
ENCRYPTION_KEY=

# Mollie (Dashboard > Entwickler > API-Schlüssel). test_... zum Testen, live_... für echte Zahlungen.
MOLLIE_API_KEY=

# E-Mail-Versand über Resend (optional; ohne Schlüssel werden Mails nur protokolliert)
RESEND_API_KEY=
MAIL_FROM="Arbitrage Radar <hallo@example.com>"

# eBay Developer Program: App-ID (Client ID), Cert-ID (Client Secret), RuName (Redirect-Name)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_ENV=production

# Amazon Selling Partner API: App-ID und LWA-Zugangsdaten der registrierten App
AMAZON_SP_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
